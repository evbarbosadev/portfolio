{
    "ci": {
        "collect": {
            "startServerCommand": "pnpm preview --port 4173 --strictPort",
            "startServerReadyPattern": "Local",
            "url": [
                "http://localhost:4173/",
                "http://localhost:4173/en",
                "http://localhost:4173/proyectos/nova"
            ],
            "numberOfRuns": 3,
            "settings": {
                "chromeFlags": "--lang=es-ES"
            }
        },
        "assert": {
            "assertions": {
                "categories:performance": ["error", { "minScore": 0.9 }],
                "categories:accessibility": ["error", { "minScore": 0.95 }],
                "categories:best-practices": ["error", { "minScore": 0.95 }],
                "categories:seo": ["error", { "minScore": 0.95 }],
                "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
                "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
                "resource-summary:script:size": ["error", { "maxNumericValue": 160000 }],
                "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 20000 }],
                "resource-summary:font:size": ["error", { "maxNumericValue": 64000 }]
            }
        },
        "upload": {
            "target": "filesystem",
            "outputDir": ".lighthouseci"
        }
    }
}
